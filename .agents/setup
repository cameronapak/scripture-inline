#!/usr/bin/env bash
# Prepares a fresh orb: the pinned pnpm and the locked dependencies.
# The docs page runs as a declared service (.amp/services.yaml), not here.
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '\n==> %s\n' "$*"; }

want="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
step "pnpm $want"
if [ "$(pnpm --version 2>/dev/null || true)" != "$want" ]; then
  corepack enable
  corepack prepare "pnpm@$want" --activate
fi
pnpm --version

step "Dependencies"
time pnpm install --frozen-lockfile

if [ -z "${VITE_YVP_APP_KEY:-}" ] && ! grep -qs '^VITE_YVP_APP_KEY=' .env.local; then
  echo "Note: VITE_YVP_APP_KEY is not set. Cards and passages on the docs page need a public app key."
fi
